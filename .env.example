# LLM provider keys (unset providers are skipped).
# Each provider takes one key (NAME=...) and/or a pool NAME_1, NAME_2, ...
# (contiguous from 1; duplicates dropped). Calls rotate over the pool and move
# to the next key on 429 before failing over. Use keys from separate orgs:
# free-tier limits (e.g. Groq 8K tokens/min) are per org, not per key.
GROQ_API_KEY=
# GROQ_API_KEY_1=
# GROQ_API_KEY_2=
# GEMINI_API_KEY_1=
MISTRAL_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=

# Cooldown (s) for a rate-limited key when the 429 has no Retry-After
LLM_KEY_COOLDOWN_S=60

# Routing and cache
LLM_PROFILE=demo
LLM_CACHE=true
LLM_CACHE_PATH=llm_cache.db
# bank = guard-checked templates in config/nlg_bank.json (no LLM call); llm | template
NLG_MODE=bank
NLU_MODE=llm

# Storage
DB_PATH=debt_settlement_agent.db

# Policy knobs
HOSTILITY_THRESHOLD=0.8
MAX_TURNS=24
ANCHOR_RATIO=0.7
CONCESSION_FACTOR=0.5
MAX_COUNTERS=4
CLOSE_GAP_BP=200

# Opening
FIRM_NAME=Synthetic Debt Relief
OPENING_DISCLOSURE=You are speaking with an automated agent authorized to discuss settlement options.
