# LLM provider keys (unset providers are skipped).
# Each provider takes one key (NAME=...) and/or a pool NAME_1, NAME_2, ...
# (contiguous from 1; duplicates dropped). Calls rotate over the pool and move
# to the next key on 429 before failing over. Use keys from separate orgs:
# free-tier limits (e.g. Groq 8K tokens/min) are per org, not per key.
GROQ_API_KEY=
# GROQ_API_KEY_1=
# GROQ_API_KEY_2=
# GEMINI_API_KEY_1=
MISTRAL_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
# Paid. Used by the eval-only naturalness judge (role `judge`) and, since
# Phase 41, as the demo profile's first NLU target (Claude Sonnet 5.5). Leave
# empty to keep the demo NLU on the free chain. Pool ANTHROPIC_API_KEY_1, _2, ...
# works like the others.
ANTHROPIC_API_KEY=
# Daily cap (USD per UTC day) on the demo's Claude NLU. When today's spend
# reaches it, NLU uses the free chain until 00:00 UTC. The eval judge is not
# capped by it. Spend is kept in DB_PATH (table llm_daily_spend).
CLAUDE_DAILY_BUDGET_USD=1.00

# Cooldown (s) for a rate-limited key when the 429 has no Retry-After
LLM_KEY_COOLDOWN_S=60

# Routing and cache
LLM_PROFILE=demo
LLM_CACHE=true
LLM_CACHE_PATH=llm_cache.db
# bank = guard-checked templates in config/nlg_bank.json (no LLM call); llm | template
NLG_MODE=bank
NLU_MODE=llm

# Storage
DB_PATH=debt_settlement_agent.db

# Policy knobs
HOSTILITY_THRESHOLD=0.8
MAX_TURNS=24
ANCHOR_RATIO=0.7
CONCESSION_FACTOR=0.5
# Spoken price counters per call, holds included (then accept at or below the
# accept line, else hand off).
MAX_COUNTERS=6
# Accept line: share of the client's ceiling in basis points (7500 = 75%).
ACCEPT_LINE_PCT_OF_MAX_BP=7500
# Loop guard: hand off instead of asking the same question a third time, or
# after this many rep turns in a row with no progress.
MAX_SAME_QUESTION=2
MAX_NO_PROGRESS_TURNS=4

# Opening
FIRM_NAME=Synthetic Debt Relief
OPENING_DISCLOSURE=You are speaking with an automated agent authorized to discuss settlement options.

# Engine (Phase 59, docs/ENGINE.md). Which legal plan the engine offers:
# fee_first = the take-home ranking (earliest program fee, then fewest
# payments); client_first = keep the most money in the client's account at the
# tightest point, then the smallest largest payment (more payments, so more
# bank fees). The firm's minimum client cushion (firm.json min_cushion_cents,
# set per call in the console) applies under both.
ENGINE_OBJECTIVE=fee_first
# front_loaded = collect the program fee as early as the account allows;
# proportional = never collect more of the fee than the share of the
# settlement already paid. Changes fee timing only, not affordability.
ENGINE_FEE_POLICY=front_loaded

# Voice (docs/VOICE_PLAN.md): WebRTC with Deepgram Flux STT and Aura-2 TTS.
# Needs DEEPGRAM_API_KEY (without it, Turn voice on says voice is not set up
# and text chat still works); capped by VOICE_DAILY_BUDGET_USD.
DEEPGRAM_API_KEY=
VOICE_DAILY_BUDGET_USD=1.00
# Barge-in sensitivity while the agent speaks: raise VOICE_VAD_MIN_VOLUME
# (e.g. 0.8) if noise or speaker echo pauses the agent; lower
# VOICE_VAD_START_S (e.g. 0.2) if real interruptions feel slow.
VOICE_VAD_CONFIDENCE=0.75
VOICE_VAD_MIN_VOLUME=0.7
VOICE_VAD_START_S=0.3
