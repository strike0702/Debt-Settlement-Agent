{"id": "p16", "tags": ["private"], "text": "How much cash does the borrower have on hand?", "stance": "question", "asks_client_private_info": true, "acts": ["ask_private_info"]}
{"id": "p17", "tags": ["private"], "text": "I'd like to see the client's budget, their income and expenses.", "stance": "question", "asks_client_private_info": true, "acts": ["ask_private_info"]}
{"id": "p18", "tags": ["private"], "text": "What's in the escrow account for this person today?", "stance": "question", "asks_client_private_info": true, "acts": ["ask_private_info"]}
{"id": "p19", "tags": ["private", "stt"], "text": "how much do they make a month roughly", "stance": "question", "asks_client_private_info": true, "acts": ["ask_private_info"]}
