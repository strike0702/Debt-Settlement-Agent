{"id": "hs01", "tags": ["stance_info", "heldout"], "text": "Our policy caps it at nine installments.", "stance": "info", "terms": {"max_payments": 9}, "acts": ["state_rule"]}
{"id": "hs02", "tags": ["stance_info", "heldout"], "text": "Each installment has to be at least $180.", "stance": "info", "terms": {"min_payment_cents": 18000}, "acts": ["state_rule"]}
{"id": "hs03", "tags": ["stance_info", "heldout"], "text": "We only do equal installments on these accounts.", "stance": "info", "terms": {"payment_structure": "even"}, "acts": ["state_rule"]}
{"id": "hs04", "tags": ["stance_info", "heldout"], "text": "The opening payment can't be later than May 20.", "stance": "info", "terms": {"first_payment_date": "2026-05-20"}, "acts": ["state_rule"]}
{"id": "hs05", "tags": ["stance_info", "heldout"], "text": "A larger final payment is allowed.", "stance": "info", "terms": {"payment_structure": "balloon"}, "acts": ["state_rule"]}
{"id": "hs06", "tags": ["stance_info", "heldout"], "text": "Nothing under $95 per payment.", "stance": "info", "terms": {"min_payment_cents": 9500}, "acts": ["state_rule"]}
{"id": "hs07", "tags": ["stance_info", "heldout"], "text": "Five payments is the longest plan we set up.", "stance": "info", "terms": {"max_payments": 5}, "acts": ["state_rule"]}
{"id": "hs08", "tags": ["stance_info", "heldout"], "text": "We'd want the first draft on or before June 15, and they all need to match.", "stance": "info", "terms": {"first_payment_date": "2026-06-15", "payment_structure": "even"}, "acts": ["state_rule"]}
{"id": "hs09", "tags": ["stance_info", "heldout"], "text": "Two different payment amounts at most on a plan.", "stance": "info", "terms": {"max_segments": 2}, "acts": ["state_rule"]}
{"id": "hs10", "tags": ["stance_info", "heldout"], "text": "The account has been with our office since last spring.", "stance": "info", "acts": []}
{"id": "hs11", "tags": ["stance_ask", "heldout"], "text": "We're looking for sixty percent to close it out.", "stance": "counter", "ask_pct": 60, "acts": ["price_ask"]}
{"id": "hs12", "tags": ["stance_ask", "heldout"], "agent": "counter", "text": "We could move to fifty-seven percent.", "stance": "counter", "ask_pct": 57, "acts": ["price_ask"]}
{"id": "hs13", "tags": ["stance_ask", "heldout"], "text": "Settle for $2,400 total and we'll close the file.", "stance": "counter", "ask_total_cents": 240000, "acts": ["price_ask"]}
{"id": "hs14", "tags": ["stance_ask", "heldout"], "agent": "confirm", "text": "Make it five payments instead of four.", "stance": "counter", "terms": {"max_payments": 5}, "acts": ["state_rule"]}
{"id": "hs15", "tags": ["stance_ask", "heldout"], "agent": "confirm", "text": "Push the start to June 10 instead.", "stance": "counter", "terms": {"first_payment_date": "2026-06-10"}, "acts": ["state_rule"]}
{"id": "hs16", "tags": ["stance_ask", "heldout"], "text": "Our number is forty-eight percent of the balance.", "stance": "counter", "ask_pct": 48, "acts": ["price_ask"]}
{"id": "hs17", "tags": ["stance_ask", "heldout"], "agent": "counter", "text": "Bump it to fifty-three percent and I can take it upstairs.", "stance": "counter", "ask_pct": 53, "acts": ["price_ask"]}
{"id": "hs18", "tags": ["closing", "heldout"], "text": "Alright, I think we're finished for today.", "stance": "other", "wants_to_end": true, "acts": ["end_call"]}
{"id": "hs19", "tags": ["closing", "heldout"], "text": "Okay, have a good one.", "stance": "other", "wants_to_end": true, "acts": ["end_call"]}
